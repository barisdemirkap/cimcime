<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cimcime.telegram-channel</string>
  <key>ProgramArguments</key>
  <array>
    <!-- claude switches to non interactive "print" mode whenever stdout isn't a TTY
         (true under launchd, which redirects StandardOutPath to a file); the channels
         flag then crash loops on "Input must be provided either through stdin or as a
         prompt argument when using print mode". /usr/bin/script allocates a real pty
         so claude sees a TTY and starts its normal persistent session instead.
         launchd gives stdin /dev/null, which script forwards as EOF (^D) and makes claude exit,
         so stdin is fed from a never-ending `tail -f /dev/null` pipe. -->
    <string>/bin/sh</string>
    <string>-c</string>
    <string>tail -f /dev/null | /usr/bin/script -q /dev/null CLAUDE_BIN_PATH --channels plugin:telegram@claude-plugins-official --append-system-prompt 'Messages arriving as &lt;channel source="telegram"&gt; are from the user on Telegram, who cannot see this terminal. ALWAYS answer them by calling the telegram reply tool with the chat_id from the tag; plain text output is never delivered.'</string>
  </array>
  <key>WorkingDirectory</key><string>REPO_PATH</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>BUN_DIR:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>REPO_PATH/logs/launchd-telegram-channel.out</string>
  <key>StandardErrorPath</key><string>REPO_PATH/logs/launchd-telegram-channel.err</string>
</dict>
</plist>
