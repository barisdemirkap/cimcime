<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cimcime.telegram-channel</string>
  <key>ProgramArguments</key>
  <array>
    <string>CLAUDE_BIN_PATH</string>
    <string>--channels</string>
    <string>plugin:telegram@claude-plugins-official</string>
  </array>
  <key>WorkingDirectory</key><string>REPO_PATH</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>REPO_PATH/logs/launchd-telegram-channel.out</string>
  <key>StandardErrorPath</key><string>REPO_PATH/logs/launchd-telegram-channel.err</string>
</dict>
</plist>
