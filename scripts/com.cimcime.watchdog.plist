<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cimcime.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO_PATH/scripts/watchdog.sh</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>REPO_PATH/logs/launchd-watchdog.err</string>
</dict>
</plist>
